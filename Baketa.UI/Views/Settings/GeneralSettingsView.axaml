<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Baketa.UI.ViewModels.Settings"
             xmlns:controls="using:Baketa.UI.Controls"
             xmlns:converters="using:Baketa.UI.Converters"
             xmlns:local="using:Baketa.UI.Extensions"
             x:Class="Baketa.UI.Views.Settings.GeneralSettingsView"
             x:DataType="vm:GeneralSettingsViewModel">

    <Design.PreviewWith>
        <Border Padding="20" Width="600" Height="800">
            <!-- デザインタイム用のダミーデータ -->
        </Border>
    </Design.PreviewWith>

        <StackPanel Margin="20,20,20,40" Spacing="20">
            <!-- ヘッダー -->
            <StackPanel Spacing="8">
                <TextBlock Text="{local:Localize Settings_General_Title}" FontSize="20" FontWeight="Medium"/>
                <TextBlock Text="{local:Localize Settings_General_Subtitle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- 翻訳設定 -->
            <StackPanel Spacing="12">
                <TextBlock Text="{local:Localize Settings_General_Translation}" FontSize="16" FontWeight="Medium"/>

                <controls:SettingsItem Title="{local:Localize Settings_General_TranslationLanguage}"
                                        Description="{local:Localize Settings_General_TranslationLanguageDescription}">
                    <controls:SettingsItem.SettingContent>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                      SelectedItem="{Binding SourceLanguage}"
                                      Width="150">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding Converter={x:Static converters:LanguageCodeToDisplayNameConverter.Instance}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="→"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                            <ComboBox ItemsSource="{Binding AvailableTargetLanguages}"
                                      SelectedItem="{Binding TargetLanguage}"
                                      Width="150">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding Converter={x:Static converters:LanguageCodeToDisplayNameConverter.Instance}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </controls:SettingsItem.SettingContent>
                </controls:SettingsItem>

                <controls:SettingsItem Title="{local:Localize Settings_General_FontSize}"
                                        Description="{local:Localize Settings_General_FontSizeDescription}">
                    <controls:SettingsItem.SettingContent>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox ItemsSource="{Binding FontSizeOptions}"
                                      SelectedItem="{Binding FontSize}"
                                      Width="80"/>
                            <TextBlock Text="{local:Localize Settings_General_FontSizeUnit}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </controls:SettingsItem.SettingContent>
                </controls:SettingsItem>

                <TextBlock Text="{local:Localize Settings_General_LanguagePairWarning}"
                           FontSize="11"
                           Foreground="#D83B01"
                           IsVisible="{Binding !IsLanguagePairValid}"/>
            </StackPanel>

            <StackPanel DataContext="{Binding TranslationMethod}" x:DataType="vm:TranslationMethodViewModel" Spacing="10">
                <TextBlock Text="{local:Localize Gemini_Method}" FontSize="16" FontWeight="Medium"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <RadioButton Content="{local:Localize Gemini_MethodGemini}" GroupName="TranslationMethod"
                                 IsChecked="{Binding IsGemini, Mode=OneWay}" Command="{Binding SelectGeminiCommand}"/>
                    <RadioButton Content="{local:Localize Google_Title}" GroupName="TranslationMethod"
                                 IsChecked="{Binding IsGoogle, Mode=OneWay}" Command="{Binding SelectGoogleCommand}"/>
                    <RadioButton Content="{local:Localize Gemini_MethodLocal}" GroupName="TranslationMethod"
                                 IsChecked="{Binding IsLocal, Mode=OneWay}" Command="{Binding SelectLocalCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel DataContext="{Binding Gemini}" x:DataType="vm:GeminiSettingsViewModel" Spacing="10">
                <TextBlock Text="{local:Localize Gemini_Title}" FontSize="16" FontWeight="Medium"/>
                <TextBlock Text="{local:Localize Gemini_Description}" TextWrapping="Wrap"/>
                <Button Content="{local:Localize Gemini_GetKey}" Command="{Binding OpenStudioCommand}"/>
                <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding !IsBusy}">
                    <TextBox Grid.Column="0" Text="{Binding ApiKey, Mode=TwoWay}" PasswordChar="●" Watermark="{local:Localize Gemini_Key}" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="{local:Localize Gemini_SaveKey}" Command="{Binding SaveKeyCommand}"/>
                </Grid>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3"/>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                           Classes.error="{Binding IsStatusError}" Classes.success="{Binding IsStatusSuccess}">
                    <TextBlock.Styles>
                        <Style Selector="TextBlock.error">
                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                        </Style>
                        <Style Selector="TextBlock.success">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                        </Style>
                    </TextBlock.Styles>
                </TextBlock>

                <Button Content="{local:Localize Gemini_DeleteKey}" Command="{Binding DeleteKeyCommand}"/>
                <TextBlock Text="{local:Localize Gemini_Privacy}" TextWrapping="Wrap"/>
                <TextBlock Text="{local:Localize Gemini_Billing}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel DataContext="{Binding Google}" x:DataType="vm:GoogleTranslationSettingsViewModel" Spacing="10">
                <TextBlock Text="{local:Localize Google_Title}" FontSize="16" FontWeight="Medium"/>
                <TextBlock Text="{local:Localize Google_Description}" TextWrapping="Wrap"/>
                <Button Content="{local:Localize Google_GetKey}" Command="{Binding OpenStudioCommand}"/>
                <Button Content="{local:Localize Google_EnableApi}" Command="{Binding OpenApiCommand}"/>
                <Button Content="{local:Localize Google_Pricing}" Command="{Binding OpenPricingCommand}"/>
                <Button Content="{local:Localize Google_Quota}" Command="{Binding OpenQuotaCommand}"/>
                <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding !IsBusy}">
                    <TextBox Grid.Column="0" Text="{Binding ApiKey, Mode=TwoWay}" PasswordChar="●" Watermark="{local:Localize Google_Key}" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="{local:Localize Google_SaveKey}" Command="{Binding SaveKeyCommand}"/>
                </Grid>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3"/>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                           Classes.error="{Binding IsStatusError}" Classes.success="{Binding IsStatusSuccess}">
                    <TextBlock.Styles>
                        <Style Selector="TextBlock.error">
                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                        </Style>
                        <Style Selector="TextBlock.success">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                        </Style>
                    </TextBlock.Styles>
                </TextBlock>

                <Button Content="{local:Localize Google_DeleteKey}" Command="{Binding DeleteKeyCommand}"/>
                <TextBlock Text="{local:Localize Google_Privacy}" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 外観設定 -->
            <StackPanel Spacing="12">
                <TextBlock Text="{local:Localize Settings_General_Appearance}" FontSize="16" FontWeight="Medium"/>

                <controls:SettingsItem Title="{local:Localize Settings_General_Theme}"
                                        Description="{local:Localize Settings_General_ThemeDescription}">
                    <controls:SettingsItem.SettingContent>
                        <ComboBox ItemsSource="{Binding AvailableThemes}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  Width="200">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static converters:SettingsConverters.ThemeToDisplayName}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:SettingsItem.SettingContent>
                </controls:SettingsItem>

                <controls:SettingsItem Title="{local:Localize Settings_General_Language}"
                                        Description="{local:Localize Settings_General_LanguageDescription}">
                    <controls:SettingsItem.SettingContent>
                        <ComboBox ItemsSource="{Binding AvailableUiLanguages}"
                                  SelectedItem="{Binding SelectedUiLanguage}"
                                  Width="200">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NativeName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:SettingsItem.SettingContent>
                </controls:SettingsItem>
            </StackPanel>
        </StackPanel>
</UserControl>
